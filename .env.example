# .env.example - Copy this to .env and add your actual API keys
# DO NOT commit the actual .env file to version control!

# Google Maps API Keys
# Get these from: https://console.cloud.google.com/
GOOGLE_MAPS_BROWSER_KEY=your_browser_key_here
GOOGLE_MAPS_SERVER_KEY=your_server_key_here

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
PRODUCTION=False

# Email Configuration (optional - for production)
# For SendGrid: EMAIL_HOST_USER=apikey, EMAIL_HOST_PASSWORD=your_sendgrid_api_key
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key_here
DEFAULT_FROM_EMAIL=AccessAdvisr <noreply@accessadvisr.com>

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Cloudinary Image Storage (optional - for production image hosting)
# Get these from: https://cloudinary.com/console
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
